# Copy to backend/social_poster/.env and fill in.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# 'global' is the safest location for gemini-flash-latest; regional endpoints may
# lack the newest flash models. (The project REGION choice is about Model Armor,
# not this variable.)
GOOGLE_CLOUD_LOCATION=global

# Image generation model, kept in env so model churn doesn't touch code.
IMAGE_MODEL_ID=gemini-3.1-flash-image

# --- Per-agent models ---
# Defaults are all flash. The Week 4 cost experiment: drop research + the
# routing orchestrator to flash-lite, keep drafting on flash, then re-run evals
# to confirm quality parity before committing to the cheaper mix.
RESEARCH_MODEL=gemini-flash-latest
DRAFT_MODEL=gemini-flash-latest
ORCHESTRATOR_MODEL=gemini-flash-latest
# Cost experiment (uncomment to try):
# RESEARCH_MODEL=gemini-flash-lite-latest
# ORCHESTRATOR_MODEL=gemini-flash-lite-latest

# --- LinkedIn MCP ---
# Keep DRY_RUN=true except for the single happy-path verification.
DRY_RUN=true
# 3-legged OAuth token, scopes: openid profile w_member_social (see mcp/README.md)
LINKEDIN_ACCESS_TOKEN=

# --- Buffer MCP (optional) — scheduling + non-LinkedIn platforms ---
# Leave blank to skip: the agent still works LinkedIn-only without it.
BUFFER_API_KEY=
# auto (default) = LLM routes by request; buffer = force Buffer only, drops
# the LinkedIn tool; linkedin = force LinkedIn only, drops Buffer.
POST_VIA=
# Buffer has no DRY_RUN equivalent — every Buffer post is forced at least
# this many minutes into the future (customScheduled) so there's a real
# window to review/cancel it in Buffer's own UI before it goes out. Default
# 60. Set to 0 only for a live demo where an immediate real post is the point.
BUFFER_REVIEW_DELAY_MINUTES=60

# --- GCS image hosting (optional) — lets Buffer attach images ---
# Buffer's create_post can't fetch a locally-generated image file, only a
# real HTTPS URL. Set this to a bucket your credentials can write to, and
# draft_agent will upload generated images there and hand Buffer a signed
# URL good for SIGNED_URL_EXPIRY_HOURS (default 7 days).
#
# A plain public object URL (allUsers/objectViewer) does NOT work here —
# CONFIRMED LIVE: it 412s ("public access prevention is enforced") on any
# project/bucket with Public Access Prevention on, which is common on
# managed/shared GCP projects (personal projects without an organisation usually
# don't have it; the signed-URL route below works either way). A signed URL is
# the only option, and it needs a *service account's* signing identity —
# never a downloaded key file, this project's credentials policy doesn't
# allow that. Impersonation gets you a service account's signature without
# ever downloading its key:
#
# One-time setup (run once per project, by whoever has IAM admin rights —
# this is exactly the kind of manual step that belongs in pre-camp setup,
# not something the app can grant itself). Set GOOGLE_CLOUD_PROJECT and
# GCS_BUCKET_NAME below first, then from the repo root:
#   ./gcp-setup.sh
# It creates the uploader service account, grants it write access to your
# bucket, grants YOUR current gcloud identity permission to impersonate it,
# and writes GCS_SIGNING_SERVICE_ACCOUNT below for you. Safe to re-run.
# (For a deployed Agent Runtime agent instead of local dev, the impersonation
# grant needs to go to the deployed engine's own runtime service account
# instead — run the script as-is first, then re-run its step 3 gcloud
# command by hand with that account. See docs/setup-guide.html.)
#
# Leave GCS_BUCKET_NAME blank to skip entirely: images stay local-only (the
# in-chat preview still works either way, via BACKEND_PUBLIC_ORIGIN below)
# and Buffer posts stay text-only.
GCS_BUCKET_NAME=

# The dedicated service account created above — required if GCS_BUCKET_NAME
# is set. This is what actually gets impersonated to sign the upload URL.
GCS_SIGNING_SERVICE_ACCOUNT=

# How long a signed image URL stays valid. 168 (7 days) is V4's own max —
# fine here since these are short-lived post images, not permanent links.
SIGNED_URL_EXPIRY_HOURS=168

# Optional, off by default: skip signing and use plain public object URLs
# instead. Needs Public Access Prevention turned off on GCS_BUCKET_NAME
# first (Console — a deliberate step gcp-setup.sh won't take for you), then
# run ./gcp-setup.sh again with this set to grant allUsers read access.
# Every uploaded image becomes world-readable indefinitely; know that before
# opting in. A shorter plain URL is also less likely to trip Gemini's
# function-calling on Buffer's create_post (confirmed live: a long signed
# URL nested inside Buffer's assets argument can come back
# MALFORMED_FUNCTION_CALL — see docs/LEARNINGS.md).
GCS_PUBLIC_BUCKET=false

# Base URL the backend serves generate_image's local files from (mounted at
# /outputs in backend/main.py) — used to embed a browser-loadable image
# preview directly in the chat. Only needs changing if the backend isn't on
# localhost:8000 (e.g. deployed, or a different port).
BACKEND_PUBLIC_ORIGIN=http://localhost:8000

# --- Memory agent via A2A (optional) ---
# Local mock:  run `uv run python backend/mock_memory_agent.py`, then:
#   MEMORY_AGENT_CARD_URL=http://localhost:8001/.well-known/agent.json
# Real deploy: the Agent Engine card URL from docs/agent-engine-rag-setup.md.
# Leave blank to skip: the orchestrator simply won't consult memory.
MEMORY_AGENT_CARD_URL=

# --- Guardrails ---
# Created by setup/04-model-armor.sh. Blank = all guardrails off (ungoverned
# behaviour), for before/after demos.
MODEL_ARMOR_TEMPLATE_ID=your-model-armor-template-id
# Model Armor is regional (unlike Gemini's 'global' location above).
MODEL_ARMOR_REGION=your-model-armor-region
